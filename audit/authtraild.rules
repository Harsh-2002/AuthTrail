# AuthTrail opt-in auditd rules. These global exec rules can be high-volume on busy or container-dense hosts.
# Contains no -D/-b/-f globals. Requires kernel audit access; review capacity before using --enable-auditd.

-a always,exit -F arch=b64 -S execve,execveat -k authtrail-exec
-a always,exit -F arch=b32 -S execve,execveat -k authtrail-exec
